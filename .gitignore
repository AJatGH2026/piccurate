# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# local storage (dev mode thumbnail storage)
/.storage/

# evaluation harness artifacts — kept LOCAL only.
# reference.json is the hand-labelled 381-photo ground truth: a competitive
# asset, and it carries private photo filenames + timestamps. The eval scripts
# read it from disk; it must exist locally but must never be published.
/.eval/
/public/eval/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Local dev launcher with secrets — never commit
dev.cmd

# Internal documents — kept LOCAL only, never in this public repo.
# Business strategy (pricing, margins, roadmap), the identity/PII scrub runbook,
# and the commented legal drafts. Archived under
# Documents\2_11_ShortlistBuddy\Claude ShortlistBuddy\.
docs/PicCurate-WorkLog.md
docs/product-pipeline.md
docs/kundenkonservierung-pii-scrub.md
docs/legal/
docs/*.docx

# Local archive / export artifacts (offline backups, code exports) — never commit
*.bundle
*.zip
*.docx
~$*
