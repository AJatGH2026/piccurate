# AuswahlBuddy - Environment Variables
# Copy this file to .env.local and fill in the values

# ── Supabase ──────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Google Gemini — LIVE ANALYSIS ENGINE ──────────────────
# Powers /api/analyze-demo. Required in production.
# https://aistudio.google.com/app/apikey (enable billing for higher rate limits)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ── Anthropic (only kept for the model-comparison eval) ───
# Not used by the live app since Jul 2026 — Gemini Flash won the eval.
ANTHROPIC_API_KEY=

# ── OpenAI (only needed to run the model-comparison eval) ─
# https://platform.openai.com/api-keys
OPENAI_API_KEY=

# ── Stripe ────────────────────────────────────────────────
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your-key
STRIPE_SECRET_KEY=sk_test_your-key
STRIPE_WEBHOOK_SECRET=whsec_your-secret
NEXT_PUBLIC_STRIPE_PRICE_SMALL=price_xxx
NEXT_PUBLIC_STRIPE_PRICE_MEDIUM=price_xxx
NEXT_PUBLIC_STRIPE_PRICE_LARGE=price_xxx

# ── Storage ───────────────────────────────────────────────
# "local" for development (saves to .storage/ folder)
# "r2" for production (Cloudflare R2)
STORAGE_PROVIDER=local
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=piccurate-thumbnails

# ── Email ─────────────────────────────────────────────────
# "mock" for development (logs to console)
# "resend" for production
EMAIL_PROVIDER=mock
RESEND_API_KEY=
# Feedback notification mail. Both are optional overrides — the defaults are
# noreply@feedback.shortlistbuddy.com and the per-locale inbox in src/lib/email.ts.
# FEEDBACK_FROM must be an address on a domain VERIFIED IN RESEND, otherwise the
# send is rejected. FEEDBACK_TO_OVERRIDE forces every locale into one inbox.
# See docs/domain-setup.md §2b — feedback.shortlistbuddy.com is not set up yet.
FEEDBACK_FROM=
FEEDBACK_TO_OVERRIDE=

# ── Beta access gate ──────────────────────────────────────
# While "1" (the default): anonymous accounts may run an analysis and a paid
# tier does not have to be settled first. Set to "0" to go live — then a
# permanent account is required and paid tiers must be paid before analysis.
# Server-side only on purpose: the browser must not be able to spoof it.
BETA_OPEN_ACCESS=1

# ── Cloud export (optional) ───────────────────────────────
# Each provider's "Save to cloud" button appears only when its key is set.
#
# Dropbox: create a scoped app at dropbox.com/developers/apps, add redirect URI
# <APP_URL>/en/cloud/callback. Permissions: files.content.write (export to cloud)
# plus files.metadata.read + files.content.read (import at upload). To browse the
# user's whole library the app needs "Full Dropbox" access (not "App folder").
NEXT_PUBLIC_DROPBOX_APP_KEY=
#
# OneDrive (Microsoft Graph): register an Azure app as a "Single-page application"
# with redirect URI <APP_URL>/en/cloud/callback and the Files.ReadWrite scope.
NEXT_PUBLIC_ONEDRIVE_CLIENT_ID=

# ── App ───────────────────────────────────────────────────
# Canonical base URL — drives metadataBase, canonical, hreflang, sitemap,
# OpenGraph and llms.txt. In production set the LEADING domain:
#   NEXT_PUBLIC_APP_URL=https://shortlistbuddy.com
# (auswahlbuddy.de redirects here; German pages live at /de, English at /en.)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Usage tracking (optional, persistent admin dashboard) ──
# When set, every analysis call records counters (photos, tokens, cost) to
# Upstash Redis. The /admin/stats dashboard reads from there. If unset, the
# tracking is a no-op — the app works exactly as before.
#
# Setup: in Vercel → Storage → choose Upstash Redis (free tier). When you
# connect it to the project, Vercel auto-sets UPSTASH_REDIS_REST_URL and
# UPSTASH_REDIS_REST_TOKEN. Nothing to enter here for production.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Prototype access gate (optional) ──────────────────────
# When SITE_PASSWORD is set, the whole site (pages AND /api) is protected by
# HTTP Basic Auth — useful for sharing the prototype with invited testers
# without exposing the unauthenticated analysis endpoint publicly. Leave both
# empty to disable the gate (e.g. local dev). Username defaults to "demo".
#
# IMPORTANT: this runs in the Edge runtime (src/proxy.ts), which does NOT read
# .env.local. Set SITE_PASSWORD as a REAL host env var (e.g. Vercel project
# settings) for the gate to take effect — a value in .env.local is ignored.
SITE_USER=demo
SITE_PASSWORD=

# ── Google tag: GA4 + Google Ads (optional, dormant until set) ──
# Analytics + ad-conversion tracking with Consent Mode v2. When neither id is
# set, the tag and the cookie-consent banner are fully dormant (no cookies, no
# banner). Set these at public launch to measure the Google Ads beta.
# - GA4_ID:      GA4 measurement id, e.g. G-XXXXXXX (funnel analytics)
# - GOOGLE_ADS_ID: Google Ads id, e.g. AW-XXXXXXXXX (conversion tracking)
# - CONVERSION_LABEL: the conversion action label from Google Ads (fires on download)
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_GOOGLE_ADS_ID=
NEXT_PUBLIC_GOOGLE_ADS_CONVERSION_LABEL=

# ── Beta cost/abuse caps ──────────────────────────────────
# Photo-based guards on /api/analyze-demo (see product-pipeline.md §10).
# Cost scales with photos, so caps are counted in photos.
# - PER_REQUEST is ALWAYS enforced (no Upstash needed) — matches the 250-photo
#   free tier on the site.
# - DAILY and IP_DAILY are Upstash-backed budget backstops (only bite when
#   Upstash is configured). Defaults are sized to protect against runaway/bot
#   traffic without blocking a ~100-user beta; tune to taste. Set to 0 to
#   disable a cap. The hard backstop remains the Gemini billing spend limit.
BETA_MAX_PHOTOS_PER_REQUEST=250
BETA_DAILY_PHOTO_CAP=20000
BETA_IP_DAILY_PHOTO_CAP=750

# ── Admin dashboard / eval endpoints ──────────────────────
# Protects /admin/stats and /api/eval/labels INDEPENDENTLY of the Basic Auth
# gate (which is off during the public beta). Set to a long random string.
# Access the dashboard at /admin/stats?key=<ADMIN_TOKEN>. If unset, both the
# admin page and the eval endpoints return 404 (disabled).
ADMIN_TOKEN=
